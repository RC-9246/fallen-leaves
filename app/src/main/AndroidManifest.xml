<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.pagetrim.app" android:versionCode="11" android:versionName="1.5.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="37"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"/>
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" android:maxSdkVersion="33"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application android:label="@string/app_name" android:icon="@drawable/ic_leaf" android:theme="@style/AppTheme"
        android:extractNativeLibs="true" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".StorageReviewActivity" android:exported="false"/>
        <activity android:name=".AppReviewActivity" android:exported="false"/>
        <activity android:name=".ScopeActivity" android:exported="false"/>
        <service android:name=".ReclaimTile" android:label="回收文件页"
            android:icon="@drawable/ic_tile" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>
        <service android:name=".WatchService" android:exported="false" android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started RAM monitoring with a persistent Stop action. Checks memory pressure and user-selected intervals for alerts or selected memory reclamation while other apps are in use."/>
        </service>
    </application>
</manifest>
